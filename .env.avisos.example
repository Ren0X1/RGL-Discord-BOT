# ============================================================================
#  RGL Discord BOT — avisos automáticos
#  Copia este fichero a .env.avisos (al lado del .env normal).
#
#  Aquí van las cosas que el bot vigila por su cuenta: repos de GitHub y juegos
#  de Steam. Son listas que crecen y ensuciaban el .env principal, así que
#  viven aparte. config.py carga los dos ficheros; si este no existe, estas
#  funciones simplemente se quedan apagadas.
#
#  Se guarda en los backups automáticos junto al resto de .env*.
# ============================================================================


# --- Aviso de nuevas releases de GitHub -------------------------------------
# Repos a vigilar ("owner/repo"), separados por comas. Vacío = desactivado.
GITHUB_RELEASES_REPOS=
# Canal donde anunciar las nuevas releases.
GITHUB_RELEASES_CHANNEL_ID=
# Minutos entre comprobaciones (mínimo 5).
GITHUB_RELEASES_INTERVAL=15
# A quién pingar al anunciar (@everyone, @here, <@&ID_ROL> o vacío para no pingar).
GITHUB_RELEASES_MENTION=@everyone
# Opcional: token de GitHub para más límite de la API (no hace falta para repos públicos).
GITHUB_TOKEN=


# --- Noticias oficiales de Steam --------------------------------------------
# Publica en un canal lo que los desarrolladores anuncian en la pestaña de
# novedades de Steam (parches, devblogs, eventos). Un hilo por juego dentro del
# canal, y cada noticia pinga al rol de ese juego. El canal se queda libre para
# poner ahí el panel de reaction roles con el que la peña se asigna los roles.
STEAM_NEWS_ENABLED=true
# Canal donde se crean los hilos de noticias.
STEAM_NEWS_CHANNEL_ID=
# Juegos a vigilar: appid:ID_DEL_ROL:Nombre[:emoji], separados por comas.
#   - El appid está en la URL de la tienda: store.steampowered.com/app/730/ -> 730
#   - El rol puede ir vacío (730::Counter-Strike 2) para no pingar a nadie.
#   - El emoji es opcional; por defecto 📰. Sale en el nombre del hilo.
# Ejemplo:
#   STEAM_NEWS_JUEGOS=730:123456789:Counter-Strike 2:🔫, 252490:987654321:Rust:🪓
#
# OJO: esta lista ya no es la única. Desde Discord, /noticias_juego añade juegos
# en caliente (se guardan en data/steam_juegos.json, que entra en los backups) y
# /noticias_lista los enseña todos. Si un appid está en los dos sitios, manda el
# del comando. Aquí solo hace falta poner los que quieras fijos en el fichero.
STEAM_NEWS_JUEGOS=
# Minutos entre comprobaciones (mínimo 5).
STEAM_NEWS_INTERVAL=20
# Máximo de noticias por juego y vuelta, para que un día movidito no reviente el hilo.
STEAM_NEWS_MAX=3
# Discord archiva los hilos si nadie habla en ellos (7 días como mucho), y un
# hilo archivado deja de verse en el canal. Con esto el bot pasa cada día por
# todos los hilos de noticias, suelta un mensaje y lo borra al momento: cuenta
# como actividad, así que no se archivan, y no queda rastro.
STEAM_NEWS_KEEPALIVE=true
# Hora (0-23, hora local de TIMEZONE) a la que hace esa pasada.
STEAM_NEWS_KEEPALIVE_HOUR=11
