# ============================================================================
#  RGL Discord BOT — avisos automáticos
#  Copia este fichero a .env.avisos (al lado del .env normal).
#
#  Aquí van las cosas que el bot vigila por su cuenta: repos de GitHub y juegos
#  de Steam. Son listas que crecen y ensuciaban el .env principal, así que
#  viven aparte. config.py carga los dos ficheros; si este no existe, estas
#  funciones simplemente se quedan apagadas.
#
#  Se guarda en los backups automáticos junto al resto de .env*.
# ============================================================================


# --- Avisos de GitHub --------------------------------------------------------
# Se vigilan USUARIOS enteros, no repos sueltos: el bot se baja todos los repos
# publicos de cada usuario y los sigue solo, asi que al crear un repo nuevo no
# hay que tocar nada aqui. Separados por comas.
GITHUB_USERS=Ren0X1
# Opcional: repos sueltos de otra gente ("owner/repo", por comas).
GITHUB_REPOS=
# Canal donde se publican los avisos.
GITHUB_CHANNEL_ID=
# Minutos entre comprobaciones (minimo 5).
GITHUB_INTERVAL=15
# Que se anuncia. Los commits estan para los repos que no sacan releases.
GITHUB_AVISAR_RELEASES=true
GITHUB_AVISAR_COMMITS=true
GITHUB_AVISAR_REPOS=true
# Cuantos commits se listan como mucho en cada aviso (el resto sale como "y N mas").
GITHUB_COMMITS_MAX=5
# Los forks suelen ser ruido; ponlo a true si los quieres vigilar tambien.
GITHUB_INCLUIR_FORKS=false
# A quien pingar (@everyone, @here, <@&ID_ROL> o vacio para no pingar).
# Las releases son noticia; los commits pasan cada dia, asi que por defecto no pingan.
GITHUB_RELEASES_MENTION=@everyone
GITHUB_COMMITS_MENTION=
# Opcional pero recomendado: un token personal sube el limite de la API de GitHub
# de 60 a 5000 peticiones/hora. No hace falta ningun permiso, con uno vacio vale.
GITHUB_TOKEN=


# --- Noticias oficiales de Steam --------------------------------------------
# Publica en un canal lo que los desarrolladores anuncian en la pestaña de
# novedades de Steam (parches, devblogs, eventos). Un hilo por juego dentro del
# canal, y cada noticia pinga al rol de ese juego. El canal se queda libre para
# poner ahí el panel de reaction roles con el que la peña se asigna los roles.
STEAM_NEWS_ENABLED=true
# Canal donde se crean los hilos de noticias.
STEAM_NEWS_CHANNEL_ID=
# Juegos a vigilar: appid:ID_DEL_ROL:Nombre[:emoji], separados por comas.
#   - El appid está en la URL de la tienda: store.steampowered.com/app/730/ -> 730
#   - El rol puede ir vacío (730::Counter-Strike 2) para no pingar a nadie.
#   - El emoji es opcional; por defecto 📰. Sale en el nombre del hilo.
# Ejemplo:
#   STEAM_NEWS_JUEGOS=730:123456789:Counter-Strike 2:🔫, 252490:987654321:Rust:🪓
#
# OJO: esta lista ya no es la única. Desde Discord, /noticias_juego añade juegos
# en caliente (se guardan en data/steam_juegos.json, que entra en los backups) y
# /noticias_lista los enseña todos. Si un appid está en los dos sitios, manda el
# del comando. Aquí solo hace falta poner los que quieras fijos en el fichero.
STEAM_NEWS_JUEGOS=
# Minutos entre comprobaciones (mínimo 5).
STEAM_NEWS_INTERVAL=20
# Máximo de noticias por juego y vuelta, para que un día movidito no reviente el hilo.
STEAM_NEWS_MAX=3
# Discord archiva los hilos si nadie habla en ellos (7 días como mucho), y un
# hilo archivado deja de verse en el canal. Con esto el bot pasa cada día por
# todos los hilos de noticias, suelta un mensaje y lo borra al momento: cuenta
# como actividad, así que no se archivan, y no queda rastro.
STEAM_NEWS_KEEPALIVE=true
# Hora (0-23, hora local de TIMEZONE) a la que hace esa pasada.
STEAM_NEWS_KEEPALIVE_HOUR=11

# --- Panel de roles automático ---
# Al añadir un juego con /noticias_juego el bot le crea su rol, lo mete en un
# panel de roles por botón (de los de /roles_crear) y republica el panel solo.
# Aquí va el NOMBRE de ese panel; vacío = no se toca ningún panel.
STEAM_NEWS_PANEL=noticias de juegos
# Canal donde vive el panel. Vacío = el mismo de los hilos (STEAM_NEWS_CHANNEL_ID).
STEAM_NEWS_PANEL_CANAL_ID=
# Crear el rol del juego si no se pasa uno en /noticias_juego.
STEAM_NEWS_ROL_AUTO=true
# ID de un rol del que copiar permisos, si destaca y si se puede mencionar.
# Lo suyo es poner uno de los roles de noticias que ya tengas, para que salgan
# todos igual. Vacío = rol limpio, sin permisos y mencionable.
STEAM_NEWS_ROL_PLANTILLA=
# Cómo se llama el rol nuevo. Vale {emoji}, {nombre} y {appid}.
STEAM_NEWS_ROL_FORMATO={emoji}︙Noticias {nombre}
# Colores que se van repartiendo entre los roles nuevos (hex, por comas).
STEAM_NEWS_ROL_COLORES=#E74C3C,#3498DB,#2ECC71,#E67E22,#9B59B6,#1ABC9C,#F1C40F,#E91E63,#00BCD4,#795548
